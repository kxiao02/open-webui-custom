# =============================
# Base stack (docker-compose.yaml)
# =============================

# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://ollama:11434'

# OpenAI backend for OpenWebUI base stack
# Default for base compose: http://host.docker.internal:8081/v1
OPENAI_API_BASE_URL='http://host.docker.internal:8081/v1'
OPENAI_API_KEY=''
OPENAI_API_BASE_URLS='http://host.docker.internal:8081/v1'
OPENAI_API_KEYS=''

# OpenWebUI runtime toggles
ENABLE_OPENAI_API=true
ENABLE_OLLAMA_API=false
OPEN_WEBUI_PORT=8080
WEBUI_SECRET_KEY=''

# =============================
# Adapter override (docker-compose.openai-adapter.yaml)
# =============================

# OpenAI adapter service exposure
OPENAI_ADAPTER_PORT=8000

# Adapter upstream and model alias settings
ADAPTER_UPSTREAM_BASE_URL='http://host.docker.internal:8081/v1'
ADAPTER_UPSTREAM_API_KEY=''
ADAPTER_UI_MODEL_ID='miniagent-chat'
ADAPTER_UPSTREAM_MODEL_ID='deepagent'
ADAPTER_TIMEOUT_SECONDS=120
ADAPTER_MODELS_TIMEOUT_SECONDS=2

# Optional inbound key required by adapter /v1 endpoints
ADAPTER_API_KEY=''

# =============================
# Build-time mirrors and image tuning
# =============================

PIP_INDEX_URL='https://pypi.tuna.tsinghua.edu.cn/simple'
UV_INDEX_URL='https://pypi.tuna.tsinghua.edu.cn/simple'
PIP_TRUSTED_HOST='pypi.tuna.tsinghua.edu.cn'
NPM_CONFIG_REGISTRY='https://registry.npmmirror.com'
GITHUB_MIRROR_PREFIX='https://ghfast.top/https://github.com'
NODE_MAX_OLD_SPACE_SIZE=4096
HF_ENDPOINT='https://hf-mirror.com'
PYTORCH_INDEX_URL_CPU=''
PYTORCH_INDEX_URL_CUDA=''

# =============================
# Optional runtime settings
# =============================

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Optional APT mirrors for Docker builds (Debian base image)
# Example:
# APT_MIRROR='https://mirrors.aliyun.com/debian'
# APT_SECURITY_MIRROR='https://mirrors.aliyun.com/debian-security'
APT_MIRROR=''
APT_SECURITY_MIRROR=''
